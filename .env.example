API_HASH=0123456789abcdef0123456789abcdef
API_ID=123456
ATLAS_SEARCH_FUZZY=true
BACKFILL_AUTO=false
BACKFILL_CHAT_IDS=-1001234567890
BACKFILL_INTERVAL_SECONDS=3600
BOT_TOKEN=123456789:REPLACE_WITH_TOKEN_FROM_BOTFATHER
DELETE_COMMANDS=false
DIAG_SECRET=change-me
ENABLE_ATLAS_SEARCH=true
ENRICH_DEBUG=false
LOGS_CHANNEL=-1001234567890
LOG_LEVEL=INFO
MAX_LINKS_PER_PAGE=20
MAX_MSG=1000
MAX_QUERY_LEN=100
MEDIA_INDEX_FOLDER=media-index
MONGODB_NAME=tg_index
MONGO_ALLOW_LAZY=true
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
OWNER_ID=123456789
PORT=8080
RANK_CANDIDATE_LIMIT=20
RANK_CODEC_WEIGHT=1.0
RANK_FILENAME_MATCH=2.0
RANK_FNAME_LEN_PENALTY_DIV=4.0
RANK_PREFIX_BOOST=1.5
RANK_QUALITY_WEIGHT=3.0
RANK_RECENCY_WEIGHT=0.5
RANK_TITLE_WEIGHT=4.0
RANK_TRIGRAM_WEIGHT=2.5
RANK_YEAR_WEIGHT=1.0
SEARCH_COOLDOWN=3
SEARCH_STREAM_URL=https://example.com/stream
SESSION_ENC_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
SESSION_STRING=REPLACE_WITH_TELETHON_STRING_SESSION
TARGET_CHAT_ID=-1001234567890
TELEGRAPH_API_TOKEN=REPLACE_WITH_TELEGRAPH_TOKEN
TELEGRAPH_DB=media-index

# Optional: run the Telegram bot clients inside the API process (instead of a
# separate `python -m app.main` process). Do NOT enable this while main.py is
# also running with the same credentials (double sessions). Auto backfill
# (BACKFILL_AUTO) additionally requires this to be enabled.
RUN_BOT_IN_API=false

# Keep this Free Render instance awake (opt-in). When 1, the process requests its
# own public /health/live every KEEP_WARM_INTERVAL_SECONDS so it never reaches
# Render's 15-minute idle spin-down - the state in which Telegram's delivery
# times out and the bot looks deaf. A running Free service uses ~730 of the 750
# instance-hours a workspace gets per month, so enable it on ONE service only.
KEEP_WARM=0
KEEP_WARM_INTERVAL_SECONDS=600
# Optional: ping this URL instead of PUBLIC_URL/RENDER_EXTERNAL_URL + /health/live
KEEP_WARM_URL=

# Guards GET /status, which reports the webhook Telegram is delivering to and
# its last delivery error. Unset = the endpoint answers 404.
STATUS_TOKEN=change-me

# Diagnostic scripts (read-only env vars; no chat ids or group names are
# stored in this repo)
CHECK_CHAT_IDS=-1001234567890
QUERY_CHAT_ID=-1001234567890
DIAG_TARGET_CHAT_ID=-1001234567890
DIAG_TARGET_TITLE=
DIAG_SEARCH_TEXT=
